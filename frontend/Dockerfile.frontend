FROM docker.artifactory-dogen.group.echonet/node:22-alpine AS builder
WORKDIR /app
COPY package.json package-lock.json ./
COPY .npmrc ./
RUN npm ci --ignore-scripts
COPY . .
RUN npm run build

FROM docker.artifactory-dogen.group.echonet/nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
